{
  "name": "dune-and-grills-backend",
  "version": "1.0.0",
  "description": "Backend API for Dune & Grills restaurant website",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node data/seed.js",
    "seed:blog": "node data/seedBlog.js",
    "seed:profiles": "node data/seedProfiles.js",
    "seed:offers": "node data/seedOffers.js",
    "seed:rewards": "node data/seedRewards.js",
    "migrate:rewards": "node data/migrateRewards.js",
    "migrate:offers": "node data/migrateOfferCoupons.js",
    "migrate:categories": "node data/migrateCategories.js",
    "test:kitchen": "node --test tests/kitchenService.test.js",
    "test:settings": "node --test tests/restaurantSettingsService.test.js",
    "test:customers": "node tests/customerCrmIntegration.js",
    "test:inventory": "node --test tests/inventoryUnitService.test.js && node tests/inventoryIntegration.js",
    "test:pos": "node tests/posIntegration.js",
    "test:customizations": "node tests/menuCustomizationIntegration.js",
    "test:sku": "node tests/inventorySkuIntegration.js",
    "test:expenses": "node tests/expenseIntegration.js",
    "test:safety": "node --test tests/productionSafety.test.js",
    "test:phase2": "node --test tests/phase2Operational.test.js && node tests/phase2Integration.js",
    "test:phase3a": "node tests/phase3aIntegration.js",
    "test:phase3b": "node --test tests/phase3bReorder.test.js && node tests/phase3bIntegration.js",
    "test:auth-security": "node tests/authSecurityIntegration.js",
    "seed:expense-categories": "node data/seedExpenseCategories.js",
    "seed:inventory": "node data/seedInventory.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^7.5.0",
    "mongoose": "^8.5.2",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}
