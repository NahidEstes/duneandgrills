PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/duneandgrills
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
CLIENT_ORIGINS=http://localhost:3000
COOKIE_SAME_SITE=lax
# Development/test standalone MongoDB only. Never enable in production.
ALLOW_NON_TRANSACTIONAL_INVENTORY=false

# Match the frontend's server-only secret (32+ random characters in deployed environments).
API_PROXY_SECRET=
# Trust no arbitrary forwarded hops. Vercel uses its protected platform header;
# the authenticated Next proxy supplies the original browser IP.
TRUST_PROXY_HOPS=0
# Staging must use NODE_ENV=production, a separate replica-set DB and a strong JWT_SECRET.
# CLIENT_ORIGINS=https://duneandgrills-testing-six.vercel.app
# Do not copy real MongoDB passwords, JWT/proxy secrets or production values into this file.

# Optional customer email. Leave disabled until domain/provider and worker are ready.
CUSTOMER_EMAIL_PROVIDER=
RESEND_API_KEY=
CUSTOMER_EMAIL_FROM=
CUSTOMER_WEB_ORIGIN=
# Separate, stable random secrets (at least 32 characters); never NEXT_PUBLIC_*.
CUSTOMER_EMAIL_TOKEN_SECRET=
CUSTOMER_EMAIL_WORKER_SECRET=
# Configure a trusted scheduler to GET /api/auth/email-jobs with
# Authorization: Bearer <CUSTOMER_EMAIL_WORKER_SECRET>. No scheduler is enabled here.

# Item-specific inventory alerts. Generate once with npm run setup:stock-alerts
# -- --subject https://your-frontend-domain (writes a private ignored file).
STOCK_ALERT_WORKER_SECRET=
STOCK_ALERT_VAPID_PUBLIC_KEY=
STOCK_ALERT_VAPID_PRIVATE_KEY=
STOCK_ALERT_VAPID_SUBJECT=
# Vercel Cron only; distinct from the POST worker secret. Minute-level cron
# requires Pro/Enterprise. External schedulers can use the POST worker instead.
CRON_SECRET=
