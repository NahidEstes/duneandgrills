# Used by Next.js server rendering and the same-origin /api proxy.
BACKEND_API_URL=http://localhost:5000/api
NEXT_PUBLIC_ORDER_STATUS_POLL_SECONDS=10

# Server-only metadata/indexing configuration. Set per Vercel environment.
SITE_URL=http://localhost:3000
SITE_ENV=development
# Staging: SITE_URL=https://duneandgrills-testing-six.vercel.app ; SITE_ENV=staging
# Future production: set SITE_URL to the approved production origin; SITE_ENV=production.
# Backend target must be HTTPS in staging/production and include /api.
# Shared server-to-server secret for verified client IPs; never NEXT_PUBLIC_.
API_PROXY_SECRET=
# Normally automatic: VERCEL_DEPLOYMENT_ID / Next BUILD_ID controls SW cache versions.
# Only set a unique override when your hosting adapter cannot expose a build identifier.
PWA_CACHE_VERSION=
