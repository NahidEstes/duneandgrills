{
  "expo": {
    "name": "Dune & Grills",
    "slug": "dune-and-grills",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/brand.png",
    "scheme": "duneandgrills",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.duneandgrills.customer",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.duneandgrills.customer",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/brand.png",
        "backgroundColor": "#e89425"
      },
      "predictiveBackGestureEnabled": true,
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/brand.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#101010",
          "image": "./assets/images/brand.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "appEnvironment": "development",
      "apiUrl": "https://duneandgrills-testing-six.vercel.app/api",
      "router": {},
      "eas": {
        "projectId": "b21d6508-3510-4d0d-b04f-a2abb8e3f39c"
      }
    },
    "owner": "nahidestes"
  }
}
