# EAS archives this Git repository. Include only the self-contained mobile apps.
/*
!/mobile
!/rider-mobile
!/notebook-mobile

# Mirror mobile/.gitignore; keep generated CNG projects out of cloud builds.
mobile/node_modules
mobile/.expo
mobile/dist
mobile/web-build
mobile/expo-env.d.ts
mobile/.kotlin
mobile/*.orig.*
mobile/*.jks
mobile/*.p8
mobile/*.p12
mobile/*.key
mobile/*.mobileprovision
mobile/*.pem
mobile/.metro-health-check*
mobile/npm-debug.*
mobile/yarn-debug.*
mobile/yarn-error.*
mobile/.DS_Store
mobile/.env*
!mobile/.env.example
mobile/*.tsbuildinfo
mobile/example
mobile/ios
mobile/android
mobile/.test-build
mobile/artifacts
mobile/credentials.json

# Independent private rider app (never include credentials or generated outputs).
rider-mobile/node_modules
rider-mobile/.expo
rider-mobile/dist
rider-mobile/.test-build
rider-mobile/artifacts
rider-mobile/android
rider-mobile/ios
rider-mobile/expo-env.d.ts
rider-mobile/.env*
!rider-mobile/.env.example
rider-mobile/credentials.json
rider-mobile/*.jks
rider-mobile/*.p12
rider-mobile/*.p8
rider-mobile/*.key
rider-mobile/*.pem
rider-mobile/*.mobileprovision
rider-mobile/*.tsbuildinfo

# Independent staff notebook app.
notebook-mobile/node_modules
notebook-mobile/.expo
notebook-mobile/dist
notebook-mobile/dist-fixture
notebook-mobile/.test-build
notebook-mobile/artifacts
notebook-mobile/android
notebook-mobile/ios
notebook-mobile/expo-env.d.ts
notebook-mobile/.env*
!notebook-mobile/.env.example
notebook-mobile/credentials.json
notebook-mobile/*.jks
notebook-mobile/*.p12
notebook-mobile/*.p8
notebook-mobile/*.key
notebook-mobile/*.pem
notebook-mobile/*.mobileprovision
notebook-mobile/*.tsbuildinfo

